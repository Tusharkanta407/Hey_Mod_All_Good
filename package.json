{
  "private": true,
  "name": "heymodallgood",
  "version": "0.0.0",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "deploy": "npm run type-check && npm run lint && devvit upload",
    "dev": "node --max-old-space-size=4096 ./node_modules/devvit/bin/devvit.js playtest",
    "dev:8gb": "node --max-old-space-size=8192 ./node_modules/devvit/bin/devvit.js playtest",
    "setup:secrets": "node scripts/sync-gemini-secret.mjs",
    "launch": "npm run deploy && devvit publish",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "login": "devvit login",
    "prettier": "prettier --write .",
    "type-check": "tsc --build"
  },
  "engines": {
    "node": ">=22.2.0"
  },
  "dependencies": {
    "@devvit/start": "0.12.24",
    "@devvit/web": "0.12.24",
    "@hono/node-server": "^2.0.3",
    "@tailwindcss/vite": "^4.1.14",
    "devvit": "0.12.24",
    "dotenv": "^17.4.2",
    "hono": "4.12.21",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^22.19.21",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "10.4.0",
    "globals": "17.6.0",
    "prettier": "3.8.3",
    "tailwindcss": "^4.1.14",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.4",
    "vite": "8.0.13"
  }
}
